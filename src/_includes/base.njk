<!doctype html>
<html lang="{{ site.sprache }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if titel %}{{ titel }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ teaser or site.beschreibung }}">
<meta name="referrer" content="strict-origin-when-cross-origin">
<link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/source-serif-4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="data:,">
</head>
<body>
<a class="skip" href="#inhalt">Zum Inhalt springen</a>

<header class="site"><div class="wrap">
  <a class="brand" href="/"><span class="mono" aria-hidden="true">CJ</span><b>{{ site.name }}</b></a>
  <nav class="main" aria-label="Hauptnavigation">
    <a href="/"{% if nav == "start" %} aria-current="page"{% endif %}>Artikel</a>
    <a href="/ueber-mich/"{% if nav == "ueber" %} aria-current="page"{% endif %}>Über mich</a>
  </nav>
</div></header>

<main id="inhalt">
{{ content | safe }}
</main>

<footer class="site"><div class="wrap">
  <span>Allgemeine Informationen, keine Rechtsberatung.</span>
  <nav aria-label="Rechtliches">
    <a href="/offenlegung/">Offenlegung</a>
    <a href="/datenschutz/">Datenschutz</a>
    <a href="{{ site.instagram }}" rel="noopener">Instagram</a>
  </nav>
</div></footer>
</body>
</html>
